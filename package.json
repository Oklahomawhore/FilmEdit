{
  "name": "filmedit-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "bin": {
    "filmedit": "dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write apps packages tests skills docs scripts README.md package.json tsconfig.json",
    "format:check": "prettier --check apps packages tests skills docs scripts README.md package.json tsconfig.json",
    "pretest": "npm run build",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node dist/cli.js",
    "doctor": "node dist/cli.js doctor",
    "model:test": "node dist/cli.js model-test",
    "test:integration": "npm run build --silent && node --import tsx --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@hyperframes/producer": "0.8.185",
    "gsap": "3.14.2",
    "puppeteer": "25.15.0",
    "shell-quote": "1.12.0",
    "typebox": "1.3.27",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
