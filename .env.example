# Fill this key. The endpoint, model and pi authentication are configured automatically.
DEEPSEEK_API_KEY=
FILMEDIT_PROVIDER=deepseek
FILMEDIT_MODEL=deepseek-flash-v4.1
# Official API identifier: deepseek-flash (V4.1 Flash). Release aliases are mapped automatically.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional Claude provider: FILMEDIT_PROVIDER=anthropic, FILMEDIT_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=
FILMEDIT_HOME=.filmedit
FILMEDIT_PYTHON=python3
FILMEDIT_MODEL_DIR=
# Enable authenticated localhost HTTP requests with this token.
FILMEDIT_API_TOKEN=
# Offline Piper Chinese TTS. Provision once with python/provision_tts.py.
# Defaults to FILMEDIT_MODEL_DIR/tts/zh_CN-huayan-medium.onnx; no TTS API key.
# FILMEDIT_TTS_MODEL=/absolute/path/to/local/voice.onnx
FILMEDIT_TTS_SPEED=1
